# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# `wrangler dev` reads this file and exposes these to the Worker as `env.*`.
# In production they are NOT read from here — set them with:
#
#   pnpm exec wrangler secret put ADMIN_TOKEN
#
# ---------------------------------------------------------------------------
# WARNING: never prefix a secret with VITE_. Vite inlines VITE_* variables into
# the browser bundle, which would publish the value to every visitor.
# ---------------------------------------------------------------------------

# Shared secret guarding GET /api/subscribers (the newsletter export endpoint).
# Leave unset and the endpoint stays disabled, always returning 401.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Only needed if you add Cloudflare Turnstile to the signup form.
# See docs/cloudflare-setup.md → Spam protection.
# TURNSTILE_SECRET=

# Only needed to deploy without `wrangler login` (e.g. from a script).
# CI uses GitHub Actions secrets instead — see .github/workflows/deploy.yml.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
