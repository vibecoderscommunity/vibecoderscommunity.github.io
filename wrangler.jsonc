{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibecoders",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },

  // The prerendered site. `run_worker_first` sends only /api/* through the
  // Worker; everything else is served straight from Cloudflare's asset edge.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Each route is prerendered to `<route>/index.html`, so a missing path
    // should 404 rather than silently serve the landing page.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  // Newsletter signups. Create the database and paste its id here:
  //   pnpm exec wrangler d1 create vibecoders-db
  // See docs/cloudflare-setup.md for the full walkthrough.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibecoders-db",
      "database_id": "1caf3b9d-9b87-4e04-91fa-0059d1d2bb72",
      "migrations_dir": "migrations"
    }
  ]
}
